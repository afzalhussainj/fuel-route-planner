DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Use DJANGO_DEBUG=false for any shared/demo deployment.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Free API key from https://www.geoapify.com/
# Keep this server-side only. Never expose it to browser JavaScript.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com

HTTP_TIMEOUT_SECONDS=30
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=2

GEOCODE_CACHE_TTL_SECONDS=86400
ROUTE_CACHE_TTL_SECONDS=3600

VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10
ROUTE_CORRIDOR_MILES=5
ROUTE_CORRIDOR_MAX_MILES=12

# JSON body size cap for the planning API (bytes).
DATA_UPLOAD_MAX_MEMORY_SIZE=65536
